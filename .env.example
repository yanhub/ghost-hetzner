# Hetzner Cloud API token: https://console.hetzner.cloud/projects -> Security -> API tokens
HCLOUD_TOKEN=

# Server settings
HCLOUD_SERVER_NAME=ghost-blog
HCLOUD_SERVER_TYPE=cx22
HCLOUD_LOCATION=fsn1
HCLOUD_IMAGE=ubuntu-24.04

# Tailscale auth key (reusable, preauthorized): https://login.tailscale.com/admin/settings/keys
# Enables SSH over Tailscale with no public port 22.
TAILSCALE_AUTH_KEY=

# Public blog URL (must match DNS before HTTPS succeeds)
GHOST_URL=https://blog.example.com

# Database passwords (generate strong values)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Optional SMTP for Ghost transactional mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ghost Blog <noreply@example.com>
